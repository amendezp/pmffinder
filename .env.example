# Anthropic API key — used server-side for stage grading + memo synthesis
ANTHROPIC_API_KEY=sk-ant-...

# Supabase — Project URL + keys from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-only — used for public memo reads (bypasses RLS).
# DO NOT expose this client-side. Never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Your deployed app's base URL (used to build shareable memo links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
